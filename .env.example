PORT=4000

# Same MySQL database the Laravel app (barakahly-commerce) already uses.
# This service only reads/writes existing tables - schema stays owned by
# Laravel's migrations. Never enable TypeORM synchronize against this DB.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=barakahly
DB_USERNAME=root
DB_PASSWORD=

APP_URL=http://localhost/barakahly-commerce/public

# Absolute path to Laravel's storage/app/public/products directory.
LARAVEL_PUBLIC_STORAGE_PATH=

# Absolute path to Laravel's storage/app/public/colors directory.
LARAVEL_COLOR_STORAGE_PATH=

MAIL_HOST=
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
ADMIN_JWT_SECRET=
